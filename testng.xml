<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Web App Automation Suite"
       parallel="tests"
       thread-count="2">

    <listeners>
        <listener class-name="com.framework.utils.TestListener"/>
    </listeners>

    <!-- Chrome Execution -->
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="com.framework.tests.FormSubmissionTest"/>
            <class name="com.framework.tests.InteractionsTest"/>
            <class name="com.framework.tests.WebTableTest"/>
            <class name="com.framework.tests.AdvancedElementsTest"/>
            <class name="com.framework.tests.HiddenAjaxTest"/>
        </classes>
    </test>

    <!-- Edge Execution -->
    <test name="Edge Tests">
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="com.framework.tests.FormSubmissionTest"/>
            <class name="com.framework.tests.InteractionsTest"/>
            <class name="com.framework.tests.WebTableTest"/>
            <class name="com.framework.tests.AdvancedElementsTest"/>
            <class name="com.framework.tests.HiddenAjaxTest"/>
        </classes>
    </test>

</suite>